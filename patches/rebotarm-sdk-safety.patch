index 0000000..2b23a66
--- /dev/null
+++ b/tests/test_gravity_scale_and_loop_stats.py
@@ -0,0 +1,83 @@
+import unittest
+from types import SimpleNamespace
+from unittest.mock import Mock, patch
+
+import numpy as np
+
+from reBotArm_control_py.actuator.rebotarm import RebotArm, _LoopStats
+from reBotArm_control_py.controllers import RebotArmEndPose
+import reBotArm_control_py.controllers.rebotarm_endpose_controller as endpose
+
+
+def arm_group(n):
+    group = Mock()
+    group.num_joints = n
+    group._mit_kp = np.full(n, 50.0)
+    group._mit_kd = np.full(n, 3.0)
+    group.get_positions.return_value = np.zeros(n)
+    return group
+
+
+def controller(n, **kwargs):
+    group = arm_group(n)
+    robot = SimpleNamespace(groups={"arm": group}, has_gripper=False)
+    with patch.object(endpose, "load_robot_model", return_value=Mock()), \
+            patch.object(endpose, "get_end_effector_frame_id", return_value=0):
+        c = RebotArmEndPose(robot, arm_control_mode="mit", **kwargs)
+    c._data = Mock()
+    return c, group
+
+
+class GravityScaleTest(unittest.TestCase):
+    def test_default_keeps_upstream_joint2_joint3_factor(self):
+        c, _ = controller(6)
+        self.assertEqual(c._gravity_ff_scale.tolist(), [1, 1.55, 1.55, 1, 1, 1])
+
+    def test_configured_scale_is_applied_to_model_gravity(self):
+        c, group = controller(6, gravity_ff_scale=[1, 1, 1, 1, 1, 1])
+        gravity = np.array([0.0, 1.5, 6.8, 2.0, 0.0, 0.0, 0.0, 0.0])
+        with patch.object(endpose, "compute_generalized_gravity", return_value=gravity), \
+                patch.object(endpose, "pad_q_for_model", side_effect=lambda m, q, n: q):
+            c._loop_cb(None, 0.01)
+        tau = group.send_mit.call_args.kwargs["tau"]
+        self.assertEqual(tau.tolist(), [0.0, 1.5, 6.8, 2.0, 0.0, 0.0])
+
+    def test_invalid_scale_is_rejected(self):
+        for scale in ([1, 1], [1, 1, float("nan"), 1, 1, 1], [1, -0.1, 1, 1, 1, 1]):
+            with self.assertRaises(ValueError):
+                controller(6, gravity_ff_scale=scale)
+
+    def test_single_joint_default_does_not_index_missing_joints(self):
+        c, _ = controller(1, use_gravity_ff=False)
+        self.assertEqual(c._gravity_ff_scale.tolist(), [1])
+
+
+class LoopStatsTest(unittest.TestCase):
+    def test_records_callback_time_period_and_overruns(self):
+        stats = _LoopStats(0.01)
+        stats.record(0.000, 0.004)
+        stats.record(0.010, 0.012)
+        stats.record(0.022, 0.005)
+        out = stats.snapshot()
+        self.assertEqual(out["iterations"], 3)
+        self.assertEqual(out["overruns"], 1)
+        self.assertAlmostEqual(out["callback_max_s"], 0.012)
+        self.assertAlmostEqual(out["period_mean_s"], 0.011)
+        self.assertAlmostEqual(out["period_max_s"], 0.012)
+
+    def test_reset_starts_a_new_window_without_losing_the_period_chain(self):
+        stats = _LoopStats(0.01)
+        stats.record(0.0, 0.001)
+        stats.snapshot(reset=True)
+        stats.record(0.010, 0.001)
+        out = stats.snapshot()
+        self.assertEqual(out["iterations"], 1)
+        self.assertAlmostEqual(out["period_mean_s"], 0.010)
+
+    def test_robot_without_a_started_loop_reports_nothing(self):
+        r = object.__new__(RebotArm)
+        self.assertEqual(r.control_loop_stats(), {})
+
+
+if __name__ == "__main__":
+    unittest.main()
