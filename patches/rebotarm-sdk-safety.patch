@@ -0,0 +1,173 @@
+import threading
+import unittest
+from unittest.mock import Mock, patch
+
+import numpy as np
+
+from reBotArm_control_py.actuator import RebotArm
+from reBotArm_control_py.controllers import RebotArmEndPose
+import reBotArm_control_py.controllers.rebotarm_endpose_controller as endpose
+
+
+class Clock:
+    def __init__(self):
+        self.now = 0.0
+
+    def monotonic(self):
+        return self.now
+
+    def sleep(self, seconds):
+        self.now += seconds
+
+
+class SdkLifecycleTest(unittest.TestCase):
+    def robot(self):
+        r = object.__new__(RebotArm)
+        r._connected = True
+        r._running = False
+        r._ctrl_thread = None
+        r._motor_map = {name: Mock() for name in ("joint1", "joint2", "gripper")}
+        r._ctrl_map = {name: Mock() for name in ("robstride", "damiao")}
+        return r
+
+    def test_disable_attempts_every_motor_after_first_failure(self):
+        r = self.robot()
+        motors = list(r._motor_map.values())
+        motors[0].disable.side_effect = RuntimeError("missing ACK")
+        with self.assertRaisesRegex(RuntimeError, "joint1: missing ACK"):
+            r.disable_all()
+        for motor in motors:
+            motor.disable.assert_called_once()
+
+    def test_disable_failure_does_not_skip_bus_close(self):
+        r = self.robot()
+        controllers = list(r._ctrl_map.values())
+        r._motor_map["joint1"].disable.side_effect = RuntimeError("missing ACK")
+        with self.assertRaisesRegex(RuntimeError, "missing ACK"):
+            r.disconnect()
+        for controller in controllers:
+            controller.close.assert_called_once()
+            controller.shutdown.assert_not_called()
+        self.assertFalse(r._connected)
+
+    def test_first_bus_close_failure_does_not_skip_second_bus(self):
+        r = self.robot()
+        second = r._ctrl_map["damiao"]
+        r._ctrl_map["robstride"].close.side_effect = RuntimeError("close fault")
+        with self.assertRaisesRegex(RuntimeError, "close fault"):
+            r.disconnect()
+        second.close.assert_called_once()
+        self.assertTrue(r._connected)
+        self.assertEqual(list(r._ctrl_map), ["robstride"])
+
+    def test_live_thread_prevents_free_but_still_attempts_all_motor_disables(self):
+        r = self.robot()
+        motors = list(r._motor_map.values())
+        controllers = list(r._ctrl_map.values())
+        r._ctrl_thread = Mock()
+        r._ctrl_thread.is_alive.return_value = True
+        with self.assertRaisesRegex(RuntimeError, "still alive"):
+            r.disconnect()
+        for motor in motors:
+            motor.disable.assert_called_once()
+        for controller in controllers:
+            controller.close.assert_not_called()
+
+    def test_stop_does_not_silently_accept_a_live_thread(self):
+        r = self.robot()
+        r._ctrl_thread = Mock()
+        r._ctrl_thread.is_alive.return_value = True
+        with self.assertRaisesRegex(RuntimeError, "did not stop"):
+            r.stop_control_loop()
+        self.assertFalse(r._running)
+
+    def test_stop_does_not_join_its_own_thread(self):
+        r = self.robot()
+        r._ctrl_thread = threading.current_thread()
+        with self.assertRaisesRegex(RuntimeError, "join itself"):
+            r.stop_control_loop()
+
+
+class SdkHomeTest(unittest.TestCase):
+    def controller(self, position=0.1):
+        c = object.__new__(RebotArmEndPose)
+        c._running = True
+        c._n = 6
+        c._dt = 0.01
+        c._q_target = np.full(6, 3.0)
+        c._qd_target = np.full(6, 0.5)
+        c._vlim_override = np.full(6, 0.25)
+        c.rebotarm = Mock()
+        c.rebotarm.get_state.return_value = (np.full(6, position), np.zeros(6), np.zeros(6))
+        return c
+
+    def run_home(self, c, on_sleep=None, **kwargs):
+        clock = Clock()
+        self.last_sent_target = c._q_target.copy()
+        def sleep(seconds):
+            self.last_sent_target = c._q_target.copy()
+            if on_sleep is not None:
+                on_sleep()
+            clock.sleep(seconds)
+        with patch.object(endpose.time, "monotonic", clock.monotonic), \
+                patch.object(endpose.time, "sleep", sleep):
+            return c.safe_home(**kwargs)
+
+    def test_trajectory_timeout_keeps_last_target_without_extra_can_read(self):
+        c = self.controller()
+        previous = c._vlim_override
+        with self.assertRaisesRegex(TimeoutError, "trajectory timed out"):
+            self.run_home(c, timeout=0.05)
+        np.testing.assert_array_equal(c._q_target, self.last_sent_target)
+        self.assertTrue(np.all(c._q_target > 0))
+        c.rebotarm.get_state.assert_called_once()
+        np.testing.assert_allclose(c._qd_target, 0.0)
+        self.assertIs(c._vlim_override, previous)
+
+    def test_settling_timeout_is_reported(self):
+        c = self.controller()
+        previous = c._vlim_override
+        with self.assertRaisesRegex(TimeoutError, "did not settle"):
+            self.run_home(c)
+        np.testing.assert_array_equal(c._q_target, self.last_sent_target)
+        self.assertIs(c._vlim_override, previous)
+
+    def test_disable_interrupts_home_without_late_feedback_reads(self):
+        c = self.controller()
+        with self.assertRaisesRegex(InterruptedError, "stopped"):
+            self.run_home(c, on_sleep=lambda: setattr(c, "_running", False))
+        c.rebotarm.get_state.assert_called_once()
+        np.testing.assert_array_equal(c._q_target, self.last_sent_target)
+
+    def test_not_running_is_not_reported_as_homing_success(self):
+        c = self.controller()
+        c._running = False
+        with self.assertRaisesRegex(RuntimeError, "not running"):
+            self.run_home(c)
+        c.rebotarm.get_state.assert_not_called()
+
+    def test_success_restores_velocity_limits(self):
+        c = self.controller()
+        previous = c._vlim_override
+        zero = (np.zeros(6), np.zeros(6), np.zeros(6))
+        c.rebotarm.get_state.side_effect = [c.rebotarm.get_state.return_value, zero]
+        self.run_home(c)
+        np.testing.assert_allclose(c._q_target, 0.0)
+        self.assertIs(c._vlim_override, previous)
+
+    def test_already_at_home_does_not_retain_old_motion_target(self):
+        c = self.controller(position=0.005)
+        self.run_home(c)
+        np.testing.assert_allclose(c._q_target, 0.005)
+        np.testing.assert_allclose(c._qd_target, 0.0)
+
+    def test_invalid_limits_reject_before_reading(self):
+        for kwargs in ({"max_vel": 0}, {"send_freq": float("nan")}, {"timeout": -1}):
+            c = self.controller()
+            with self.subTest(kwargs=kwargs), self.assertRaises(ValueError):
+                self.run_home(c, **kwargs)
+            c.rebotarm.get_state.assert_not_called()
+
+
+if __name__ == "__main__":
+    unittest.main()
