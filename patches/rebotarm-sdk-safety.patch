+class _LoopStats:
+    """Control-loop timing written by the loop thread, read by monitors.
+
+    Plain counters under a lock; the loop never blocks on readers for long.
+    """
+
+    def __init__(self, dt: float) -> None:
+        self._dt = dt
+        self._lock = threading.Lock()
+        self._reset()
+
+    def _reset(self) -> None:
+        self._count = 0
+        self._overruns = 0
+        self._elapsed_sum = 0.0
+        self._elapsed_max = 0.0
+        self._period_sum = 0.0
+        self._period_max = 0.0
+        self._periods = 0
+        self._last_start: Optional[float] = None
+
+    def record(self, start: float, elapsed: float) -> None:
+        with self._lock:
+            self._count += 1
+            self._elapsed_sum += elapsed
+            self._elapsed_max = max(self._elapsed_max, elapsed)
+            if elapsed > self._dt:
+                self._overruns += 1
+            if self._last_start is not None:
+                period = start - self._last_start
+                self._period_sum += period
+                self._period_max = max(self._period_max, period)
+                self._periods += 1
+            self._last_start = start
+
+    def snapshot(self, reset: bool = False) -> dict:
+        with self._lock:
+            out = {
+                "configured_period_s": self._dt,
+                "iterations": self._count,
+                "overruns": self._overruns,
+                "callback_mean_s": self._elapsed_sum / self._count if self._count else None,
+                "callback_max_s": self._elapsed_max if self._count else None,
+                "period_mean_s": self._period_sum / self._periods if self._periods else None,
+                "period_max_s": self._period_max if self._periods else None,
+            }
+            if reset:
+                last = self._last_start
+                self._reset()
+                # Keep the period chain continuous across report windows.
+                self._last_start = last
+            return out
+
+
