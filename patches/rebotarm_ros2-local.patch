+                self.assertFalse(hardware.has_gripper)
+                self.assertTrue(hardware.trial_mode)
+                self.assertTrue(hardware._endpos_ctrl._use_gravity_ff)
+                self.assertEqual(hardware._endpos_ctrl._gravity_ff_scale.tolist(), [1.0] * 6)
+                self.assertEqual(hardware._arm_mit_kp.tolist(), [50, 150, 150, 50, 50, 50])
+                self.assertEqual(hardware._trial_position_limits.tolist(), LIMITS)
+                self.assertEqual(hardware._safe_home_settle, 0.02)
+                controller.assert_not_called()
+            finally:
+                resolve_hardware_config(None, "rs", "")
+
+    def test_startup_enables_each_arm_motor_individually_on_mock_bus(self):
+        motors = []
+
+        def add_motor(motor_id, feedback_id, model):
+            motor = Mock(name=f"motor{motor_id}")
+            motor.robstride_get_param_f32.return_value = 0.0
+            motor.get_state.return_value = None
+            motors.append(motor)
+            return motor
+
+        bus = Mock()
+        bus.add_robstride_motor.side_effect = add_motor
+        with patch("reBotArm_control_py.actuator.rebotarm.Controller", return_value=bus):
+            try:
+                hardware = HardwareManager(hardware_config=str(CONFIG))
+                hardware._robot.start_control_loop = Mock()
+                hardware.connect()
+                self.assertEqual(bus.add_robstride_motor.call_args_list,
