+
+CONFIG = _workspace_root().parent / "scripts/config/arm_hold_trial.yaml"
+LIMITS = [[-0.10, 0.10], [-0.05, 0.10], [-0.05, 0.10], [-0.12, 0.12], [-0.12, 0.12], [-0.12, 0.12]]
