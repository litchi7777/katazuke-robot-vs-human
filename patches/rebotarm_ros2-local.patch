+class NodeCleanupTest(unittest.TestCase):
+    def test_hardware_error_does_not_skip_executor_and_ros_cleanup(self):
+        module = importlib.import_module("rebotarmcontroller.rebotarm_controller")
+        node = Mock()
+        node.shutdown.side_effect = RuntimeError("cleanup fault")
+        executor = Mock()
+        executor.spin.side_effect = KeyboardInterrupt()
+        with patch.object(module, "reBotArmController", return_value=node), \
+                patch.object(module, "MultiThreadedExecutor", return_value=executor), \
+                patch.object(module.rclpy, "init"), patch.object(module.rclpy, "try_shutdown") as stop:
+            with self.assertRaisesRegex(RuntimeError, "cleanup fault"):
+                module.main()
+        executor.shutdown.assert_called_once()
+        node.destroy_node.assert_called_once()
+        stop.assert_called_once()
