+        self.assertEqual(data["groups"], {"arm": {"joints": list(ARM_JOINTS)}})
+
+    def test_restriction_refuses_unsafe_or_inconsistent_configs(self):
+        changes = (
+            lambda d: d.update(rate=500),
+            lambda d: d.update(arm_hold_trial="true"),
+            lambda d: d.update(joint1_only_trial=True),
+            lambda d: d["groups"]["arm"].update(joints=ARM_JOINTS[:5]),
+            lambda d: d["joints"][2].update(motor_id=7),
+            lambda d: d["joints"][3].update(model="rs-06"),
+            lambda d: d["arm_hold_trial_position_limits"].pop("joint6"),
+            lambda d: d["arm_hold_trial_position_limits"].update(joint3=[0.01, 0.1]),
+            lambda d: d["arm_hold_trial_position_limits"].update(joint2=[-0.1, 3.0]),
+            lambda d: d.update(gravity_ff_scale=[1.0] * 5),
+            lambda d: d.update(gravity_ff_scale=[1.0, 2.0, 1.0, 1.0, 1.0, 1.0]),
+            lambda d: d.pop("gravity_ff_scale"),
+            lambda d: d.update(safe_home_settle_rad=0.05),
+        )
+        for change in changes:
+            data = trial_data()
+            change(data)
+            with self.assertRaises(ValueError):
+                _restrict_arm_hold_trial(data, "rs")
+        with self.assertRaises(ValueError):
+            _restrict_arm_hold_trial(trial_data(), "dm")
+
+    def test_optional_soft_gripper_is_kept_with_trial_gains(self):
+        data = trial_data()
+        data["arm_hold_trial_gripper"] = {"mit_kp": 8.0, "mit_kd": 0.3}
+        data["gripper"] = {"position_limits": {"open": 1.6, "close": 0.0}}
+        _restrict_arm_hold_trial(data, "rs")
+        self.assertEqual([j["motor_id"] for j in data["joints"]], [1, 2, 3, 4, 5, 6, 7])
+        self.assertEqual(data["joints"][-1]["MIT"], {"kp": 8.0, "kd": 0.3})
+        self.assertEqual(data["groups"]["gripper"], {"joints": ["gripper"]})
+
+    def test_soft_gripper_rejects_strong_gains_or_wide_opening(self):
+        for gripper, limits in (({"mit_kp": 50.0, "mit_kd": 0.3}, {"open": 1.6, "close": 0.0}),
+                                ({"mit_kp": 8.0}, {"open": 1.6, "close": 0.0}),
+                                ({"mit_kp": 8.0, "mit_kd": 0.3}, {"open": 5.0, "close": 0.0}),
+                                ("soft", {"open": 1.6, "close": 0.0})):
