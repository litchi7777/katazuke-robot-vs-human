+import importlib
+import threading
+import unittest
+from types import SimpleNamespace
+from unittest.mock import Mock, PropertyMock, patch
+
+import numpy as np
+
+from rebotarmcontroller.hardware_manager import HardwareManager
+
+
+class LifecycleSafetyTest(unittest.TestCase):
+    def hardware(self):
+        h = object.__new__(HardwareManager)
+        h._cmd_lock = threading.RLock()
+        h._connected = h._enabled = h._control_output_enabled = True
+        h._shutdown_requested = False
+        h._shutdown_thread = h._homing_thread = None
+        h._gravity_comp_active = False
+        h._gravity_comp_q_last = None
+        h._state_machine = "IDLE"
+        h._error_codes = []
+        h._arm_control_mode = "mit"
+        h._arm_mit_kp = np.ones(6)
+        h._arm_mit_kd = np.ones(6)
+        h._arm_group = SimpleNamespace(mode_mit=Mock(), enable=Mock(),
+                                       joint_names=[f"joint{i}" for i in range(1, 7)])
+        h._gripper_group = SimpleNamespace(mode_mit=Mock(return_value=True), enable=Mock())
+        h._gripper_target_position = 1.3
+        h._endpos_ctrl = SimpleNamespace(
+            _running=True, _q_target=np.full(6, 0.2), _qd_target=np.zeros(6),
+            _gripper_target=1.3, _send_thread=None, _stop_send=threading.Event(),
+            _moving=False, safe_home=Mock())
+        h._endpos_ctrl.set_gripper_target = Mock(
+            side_effect=lambda q: setattr(h._endpos_ctrl, "_gripper_target", q))
+        h._robot = SimpleNamespace(_connected=True, has_gripper=True, control_loop_active=True,
+                                   disable_all=Mock(), start_control_loop=Mock())
+        h._robot.stop_control_loop = Mock(side_effect=lambda: setattr(h._robot, "control_loop_active", False))
+        h._robot.disconnect = Mock(side_effect=lambda: setattr(h._robot, "_connected", False))
+        h.get_joint_positions = Mock(return_value=np.full(6, 0.2))
+        h.get_gripper_state = Mock(return_value=(1.3, 0.0, 0.0, 0))
+        return h
+
+    def test_shutdown_after_disable_never_homes_or_enables(self):
+        h = self.hardware()
+        h._enabled = False
+        h.safe_home = Mock()
+        h.shutdown()
+        h.safe_home.assert_not_called()
+        h._arm_group.enable.assert_not_called()
+        h._gripper_group.enable.assert_not_called()
+        self.assertFalse(h._connected)
+
+    def test_home_exception_still_disables_and_disconnects(self):
+        h = self.hardware()
+        h.safe_home = Mock(side_effect=TimeoutError("home timed out"))
+        with self.assertRaisesRegex(RuntimeError, "home timed out"):
+            h.shutdown()
+        h._robot.disable_all.assert_called_once()
+        h._robot.disconnect.assert_called_once()
+        self.assertFalse(h.enabled)
+        self.assertFalse(h._connected)
+        self.assertEqual(h.state_machine, "ERROR")
+
+    def test_disable_failure_remains_reported_and_disconnect_is_attempted(self):
+        h = self.hardware()
+        h.safe_home = Mock()
+        h._robot.disable_all.side_effect = RuntimeError("no motor ACK")
+        h._robot.disconnect.side_effect = RuntimeError("bus close failed")
+        with self.assertRaisesRegex(RuntimeError, "no motor ACK.*bus close failed"):
+            h.shutdown()
+        h._robot.disconnect.assert_called_once()
+        self.assertTrue(h.enabled)
+        self.assertTrue(h._connected)
+        self.assertFalse(h._control_output_enabled)
+        self.assertIn("DISABLE_FAILED", h.error_codes)
+
+    def test_control_thread_failure_does_not_skip_torque_off_attempt(self):
+        h = self.hardware()
+        h._robot.stop_control_loop.side_effect = RuntimeError("thread stuck")
+        with self.assertRaisesRegex(RuntimeError, "thread stuck"):
+            h.disable()
+        h._robot.disable_all.assert_called_once()
+        self.assertFalse(h.enabled)
+
+    def test_disable_during_gravity_compensation_does_not_restart_hold(self):
+        h = self.hardware()
+        h._gravity_comp_active = True
+        h._start_endpos_hold = Mock()
+        h.disable()
+        h._start_endpos_hold.assert_not_called()
+        h._robot.disable_all.assert_called_once()
+        self.assertFalse(h._gravity_comp_active)
+
+    def test_safe_home_preserves_gripper_target(self):
+        h = self.hardware()
+        h.set_gripper_position = Mock()
+        h.safe_home()
+        h.set_gripper_position.assert_not_called()
+        h._endpos_ctrl.set_gripper_target.assert_not_called()
+        self.assertEqual(h._endpos_ctrl._gripper_target, 1.3)
+        h._endpos_ctrl.safe_home.assert_called_once()
+
+    def test_joint1_trial_safe_home_uses_low_speed(self):
+        h = self.hardware()
+        h._joint1_only_trial = True
+        h.safe_home()
+        h._endpos_ctrl.safe_home.assert_called_once_with(max_vel=0.02)
+
+    def test_hold_refuses_nonfinite_position_without_changing_target(self):
+        h = self.hardware()
+        previous = h._endpos_ctrl._q_target.copy()
+        h.get_joint_positions.return_value = np.full(6, np.nan)
+        with self.assertRaises(ValueError):
+            h.hold_current_position()
+        np.testing.assert_array_equal(h._endpos_ctrl._q_target, previous)
+
+    def test_explicit_hold_checks_idle_enabled_and_preserves_gripper_target(self):
+        for enabled, state in ((False, "IDLE"), (True, "TRAJ_RUNNING"), (True, "ERROR")):
+            h = self.hardware()
+            h._enabled, h._state_machine = enabled, state
+            with self.assertRaises(RuntimeError):
+                h.request_position_hold()
+            h.get_joint_positions.assert_not_called()
+        h = self.hardware()
+        h.request_position_hold()
+        self.assertEqual(h._endpos_ctrl._gripper_target, 1.3)
+        h._robot.start_control_loop.assert_not_called()
+        h._arm_group.enable.assert_not_called()
+
+    def test_safe_home_on_disabled_arm_rejects_without_enabling(self):
+        h = self.hardware()
+        h._enabled = False
+        with self.assertRaisesRegex(RuntimeError, "enabled arm"):
+            h.safe_home()
+        h._arm_group.enable.assert_not_called()
+        h._endpos_ctrl.safe_home.assert_not_called()
+
+    def test_home_failure_retains_fault_state_and_gripper_target(self):
+        h = self.hardware()
+        h._endpos_ctrl.safe_home.side_effect = TimeoutError("home timeout")
+        with self.assertRaises(TimeoutError):
+            h.safe_home()
+        self.assertEqual(h.state_machine, "ERROR")
+        self.assertIn("SAFE_HOME_FAILED", h.error_codes)
+        self.assertEqual(h._endpos_ctrl._gripper_target, 1.3)
+
+    def test_startup_captures_both_positions_before_enabling(self):
+        h = self.hardware()
+        h._endpos_ctrl._gripper_target = 0.0
+        h._endpos_ctrl._q_target[:] = 0.0
+        def check_targets():
+            self.assertEqual(h._endpos_ctrl._gripper_target, 1.3)
+            np.testing.assert_allclose(h._endpos_ctrl._q_target, 0.2)
+        h._arm_group.enable.side_effect = check_targets
