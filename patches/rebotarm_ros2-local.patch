+            h.set_joint_position_target(np.zeros(6))
+        h._arm_group.enable.assert_not_called()
+
+    def test_disabled_target_is_rejected(self):
+        h = self.hardware()
+        h._enabled = False
+        before = h._endpos_ctrl._q_target.copy()
+        with self.assertRaisesRegex(RuntimeError, "disabled"):
+            h.set_joint_position_target(np.zeros(6))
+        np.testing.assert_array_equal(h._endpos_ctrl._q_target, before)
+
+    def test_disabled_hold_does_not_read_or_update_targets(self):
+        h = self.hardware()
+        h._enabled = False
+        before = h._endpos_ctrl._q_target.copy()
+        np.testing.assert_array_equal(h.hold_current_position(), before)
+        h.get_joint_positions.assert_not_called()
