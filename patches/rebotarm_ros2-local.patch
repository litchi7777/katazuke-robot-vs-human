+class RosStopPathTest(unittest.TestCase):
+    def test_invalid_later_point_rejected_before_any_motion(self):
+        actions = self.actions()
+        goal = self.goal(actions)
+        actions._hardware.validate_joint_targets.side_effect = [None, ValueError("outside measured interval")]
+        actions.execute_follow_joint_trajectory(goal)
+        actions._hardware.begin_trajectory_stream.assert_not_called()
+        actions._hardware.set_joint_position_target.assert_not_called()
+        goal.abort.assert_called_once()
+
+    def actions(self):
+        from rebotarmcontroller.ros_actions import ArmActions
+        actions = object.__new__(ArmActions)
+        actions._node = Mock()
+        actions._hardware = Mock()
+        actions._hardware.enabled = True
+        actions._hardware.state_machine = "TRAJ_RUNNING"
+        actions._hardware.joint_names = [f"joint{i}" for i in range(1, 7)]
+        return actions
+
+    def goal(self, actions):
+        from control_msgs.action import FollowJointTrajectory
+        from trajectory_msgs.msg import JointTrajectoryPoint
+        request = FollowJointTrajectory.Goal()
+        request.trajectory.joint_names = actions._hardware.joint_names
+        first = JointTrajectoryPoint(positions=[0.0] * 6)
+        last = JointTrajectoryPoint(positions=[0.2] * 6)
+        last.time_from_start.sec = 1
+        request.trajectory.points = [first, last]
+        goal = Mock()
+        goal.request = request
+        return goal
+
+    def test_cancel_before_execution_does_not_start_control(self):
+        actions = self.actions()
+        goal = self.goal(actions)
+        goal.is_cancel_requested = True
+        actions.execute_follow_joint_trajectory(goal)
+        actions._hardware.begin_trajectory_stream.assert_not_called()
+        actions._hardware.set_joint_position_target.assert_not_called()
+        goal.canceled.assert_called_once()
+
+    def test_cancel_in_execution_precedes_next_target(self):
+        actions = self.actions()
+        goal = self.goal(actions)
+        with patch.object(type(goal), "is_cancel_requested", new_callable=PropertyMock,
+                          create=True, side_effect=[False, True]):
+            actions.execute_follow_joint_trajectory(goal)
+        actions._hardware.set_joint_position_target.assert_not_called()
+        actions._hardware.hold_current_position.assert_called_once()
+        goal.canceled.assert_called_once()
+
+    def test_disabled_arm_rejects_action_goal(self):
