+        joints=[dict(name=n, motor_id=i + 1, vendor="robstride", model=m)
+                for i, (n, m) in enumerate(zip(ARM_JOINTS, models))]
+        + [dict(name="gripper", motor_id=7, vendor="robstride", model="rs-00")],
