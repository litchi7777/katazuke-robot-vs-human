+        h._gripper_group.enable.assert_not_called()
+        h._robot.start_control_loop.assert_not_called()
+
+    def test_shutdown_blocks_future_enable_and_targets(self):
+        h = self.hardware()
+        h._enabled = False
+        h.shutdown()
+        with self.assertRaisesRegex(RuntimeError, "shutdown"):
+            h.enable()
