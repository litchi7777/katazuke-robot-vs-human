+        motors = {}
+
+        def add_motor(motor_id, feedback_id, model):
+            motor = Mock(name=f"motor{motor_id}")
+            motor.robstride_get_param_f32.return_value = 0.0
+            motor.get_state.return_value = None
+            motors[motor_id] = motor
