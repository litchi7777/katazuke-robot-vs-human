+        h._robot.start_control_loop.assert_called_once()
+
+    def test_failed_position_read_prevents_enabling(self):
+        h = self.hardware()
+        h.get_gripper_state.side_effect = TimeoutError("gripper position missing")
+        with self.assertRaises(TimeoutError):
+            h._start_endpos_loop()
