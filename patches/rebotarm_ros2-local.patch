+def _restrict_joint1_trial(data: dict[str, Any], model: str) -> None:
+    trial = data.get("joint1_only_trial", False)
+    if not isinstance(trial, bool):
+        raise ValueError("joint1_only_trial must be a boolean")
+    if not trial:
+        return
+    bounds = data.get("joint1_trial_position_limits")
+    if bounds is not None and (
+        not isinstance(bounds, list) or len(bounds) != 2
+        or not all(isinstance(v, (int, float)) and math.isfinite(v) for v in bounds)
+        or not -2.8 <= bounds[0] < 0 < bounds[1] <= 2.8
+    ):
+        raise ValueError("joint1 trial position limits must straddle zero inside [-2.8, 2.8]")
+    if (model != "rs" or _arm_joint_names(data) != ["joint1"] or data.get("rate") != 100
+            or _arm_control_mode(data) != "mit"):
+        raise ValueError("joint1 trial requires RS, arm=[joint1], rate=100, MIT")
+    joint = [j for j in data.get("joints", []) if j.get("name") == "joint1"]
+    if (len(joint) != 1 or joint[0].get("motor_id") != 1
+            or joint[0].get("vendor") != "robstride" or joint[0].get("model") != "rs-06"):
+        raise ValueError("joint1 trial requires exactly the RS-06 motor with ID 1")
+    # Deep merge leaves the SDK's gripper group behind. Remove it and the other
+    # motors before constructing any SDK object or opening a CAN connection.
+    data["joints"] = joint
+    data["groups"] = {"arm": {"joints": ["joint1"]}}
+
+
+ARM_JOINTS = [f"joint{i}" for i in range(1, 7)]
+ARM_MOTOR_MODELS = ["rs-06", "rs-06", "rs-06", "rs-00", "rs-00", "rs-00"]
+
+
+def _restrict_arm_hold_trial(data: dict[str, Any], model: str) -> None:
+    """All six arm motors hold, one moves; the gripper is never registered."""
+    trial = data.get("arm_hold_trial", False)
+    if not isinstance(trial, bool):
+        raise ValueError("arm_hold_trial must be a boolean")
+    if not trial:
+        return
+    if data.get("joint1_only_trial", False):
+        raise ValueError("arm_hold_trial and joint1_only_trial are mutually exclusive")
+    if (model != "rs" or _arm_joint_names(data) != ARM_JOINTS or data.get("rate") != 100
+            or _arm_control_mode(data) != "mit"):
+        raise ValueError("arm hold trial requires RS, arm=joint1..joint6, rate=100, MIT")
+    joints = {j.get("name"): j for j in data.get("joints", [])}
+    for motor_id, (name, motor_model) in enumerate(zip(ARM_JOINTS, ARM_MOTOR_MODELS), start=1):
+        joint = joints.get(name, {})
+        if (joint.get("motor_id") != motor_id or joint.get("vendor") != "robstride"
+                or joint.get("model") != motor_model):
+            raise ValueError(f"arm hold trial requires {name} as RobStride {motor_model} ID {motor_id}")
+    limits = data.get("arm_hold_trial_position_limits")
+    if not isinstance(limits, dict) or sorted(limits) != ARM_JOINTS:
+        raise ValueError("arm hold trial needs position limits for exactly joint1..joint6")
+    for name, bounds in limits.items():
+        if (not isinstance(bounds, list) or len(bounds) != 2
+                or not all(isinstance(v, (int, float)) and math.isfinite(v) for v in bounds)
+                or not -2.8 <= bounds[0] < 0 < bounds[1] <= 2.8):
+            raise ValueError(f"{name} trial limits must straddle zero inside [-2.8, 2.8]")
+    scale = data.get("gravity_ff_scale")
+    if (not isinstance(scale, list) or len(scale) != 6
+            or not all(isinstance(v, (int, float)) and math.isfinite(v) and 0 <= v <= 1.55
+                       for v in scale)):
+        raise ValueError("arm hold trial needs gravity_ff_scale: six values in [0, 1.55]")
+    settle = data.get("safe_home_settle_rad", 0.01)
+    if not isinstance(settle, (int, float)) or not 0 < settle <= 0.03:
+        raise ValueError("safe_home_settle_rad must be in (0, 0.03]")
+    data["joints"] = [joints[name] for name in ARM_JOINTS]
+    data["groups"] = {"arm": {"joints": list(ARM_JOINTS)}}
+    gripper = data.get("arm_hold_trial_gripper")
+    if gripper is None:
+        return
+    # Optional soft gripper: squeeze torque is kp * (commanded closing beyond contact).
+    if not isinstance(gripper, dict):
+        raise ValueError("arm_hold_trial_gripper must be a mapping")
+    kp, kd = gripper.get("mit_kp"), gripper.get("mit_kd")
+    if not (isinstance(kp, (int, float)) and 0 < kp <= 20 and isinstance(kd, (int, float)) and 0 <= kd <= 2):
+        raise ValueError("arm_hold_trial_gripper needs mit_kp in (0, 20] and mit_kd in [0, 2]")
+    joint = joints.get("gripper", {})
+    if joint.get("motor_id") != 7 or joint.get("vendor") != "robstride" or joint.get("model") != "rs-00":
+        raise ValueError("arm hold trial gripper must be RobStride rs-00 ID 7")
+    limits = data.get("gripper", {}).get("position_limits", {})
+    if not (limits.get("close") == 0.0 and 0 < limits.get("open", 0) <= GRIPPER_OPEN_MAX):
+        raise ValueError(f"arm hold trial gripper needs position_limits close 0.0 and open in (0, {GRIPPER_OPEN_MAX}]")
+    joint = copy.deepcopy(joint)
+    joint["MIT"] = {"kp": float(kp), "kd": float(kd)}
+    data["joints"].append(joint)
+    data["groups"]["gripper"] = {"joints": ["gripper"]}
+
+
 def _resolve_package_urdf(data: dict[str, Any]) -> None:
     """Resolve a package:// URDF URI before passing config to the SDK."""
     value = str(data.get("urdf_path", ""))
