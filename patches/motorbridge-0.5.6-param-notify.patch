+    fn parameter_reply(motor: &RobstrideMotor, param_id: u16, value: f32) -> CanFrame {
+        CanFrame {
+            arbitration_id: build_ext_id(
+                CommunicationType::READ_PARAMETER,
+                motor.motor_id,
+                motor.feedback_id as u8,
+            ),
+            data: encode_parameter_write(param_id, value.to_le_bytes()),
+            dlc: 8,
+            is_extended: true,
+            is_rx: true,
+        }
+    }
+
+    fn wait_for_requests(bus: &MockBus, count: usize) {
+        let deadline = Instant::now() + Duration::from_secs(1);
+        while bus.sent.lock().unwrap().len() < count {
+            assert!(Instant::now() < deadline, "expected read request");
+            std::thread::yield_now();
+        }
+    }
+
+    #[test]
+    fn parameter_wait_discards_cached_value_and_wakes_on_new_reply() {
+        let bus = Arc::new(MockBus::new());
+        let motor = Arc::new(RobstrideMotor::new(2, 0xFD, "rs-06", bus.clone()).unwrap());
+        motor
+            .process_feedback_frame(parameter_reply(&motor, 0x7019, 9.0))
+            .unwrap();
+        let reading = motor.clone();
+        let task = std::thread::spawn(move || {
+            reading.get_parameter_with_host_id(0x7019, 0xFD, Duration::from_millis(100))
+        });
+        wait_for_requests(&bus, 1);
+        motor
+            .process_feedback_frame(parameter_reply(&motor, 0x7019, 0.25))
+            .unwrap();
+        assert!(matches!(task.join().unwrap().unwrap(), ParameterValue::F32(v) if v == 0.25));
+        assert_eq!(bus.sent.lock().unwrap().len(), 1);
+    }
