+//! Parameter-read benchmark using only an in-memory CAN bus. No hardware access.
+use motor_core::bus::CanFrame;
+use motor_core::controller::CoreController;
+use motor_core::test_support::MockBus;
+use motor_vendor_robstride::{
+    encode_parameter_read, encode_parameter_write, ext_id_parts, CommunicationType,
+    RobstrideMotor,
+};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+fn main() {
+    let samples = 210;
+    let delay_us = 500;
+    let bus = Arc::new(MockBus::new());
+    let controller = CoreController::new(bus.clone());
+    let motors: Vec<_> = (1..=7)
+        .map(|id| {
+            let motor = Arc::new(
+                RobstrideMotor::new(
+                    id,
+                    0xFD,
+                    if id <= 3 { "rs-06" } else { "rs-00" },
+                    controller.bus(),
+                )
+                .unwrap(),
+            );
+            controller.add_device(motor.clone()).unwrap();
+            motor
+        })
+        .collect();
+    let stop = Arc::new(AtomicBool::new(false));
+    let stop_worker = stop.clone();
+    let mock_bus = bus.clone();
+    let responder = std::thread::spawn(move || {
+        let mut index = 0;
+        while !stop_worker.load(Ordering::Acquire) {
+            let request = mock_bus.sent.lock().unwrap().get(index).copied();
+            if let Some(request) = request {
+                let (kind, host, motor_id) = ext_id_parts(request.arbitration_id);
+                assert_eq!(kind, CommunicationType::READ_PARAMETER);
+                assert_eq!(request.data, encode_parameter_read(0x7019));
+                std::thread::sleep(Duration::from_micros(delay_us));
+                let value = motor_id as f32 / 10.0;
+                mock_bus.push_rx(CanFrame {
+                    arbitration_id: (CommunicationType::READ_PARAMETER << 24)
+                        | ((motor_id as u32) << 8)
+                        | host as u32,
+                    data: encode_parameter_write(0x7019, value.to_le_bytes()),
+                    dlc: 8,
+                    is_extended: true,
+                    is_rx: true,
+                });
+                index += 1;
+            } else {
+                std::thread::sleep(Duration::from_micros(50));
+            }
+        }
+        index
+    });
+    let mut times = Vec::with_capacity(samples);
+    for index in 0..samples {
+        let motor = &motors[index % motors.len()];
+        let started = Instant::now();
+        let value = motor
+            .get_parameter_f32(0x7019, Duration::from_millis(200))
+            .unwrap();
+        times.push(started.elapsed().as_secs_f64() * 1000.0);
+        assert!((value - motor.motor_id as f32 / 10.0).abs() < 1e-6);
+    }
+    controller.close_bus().unwrap();
+    stop.store(true, Ordering::Release);
+    assert_eq!(responder.join().unwrap(), samples);
+    assert_eq!(bus.sent.lock().unwrap().len(), samples);
+    let average = times.iter().sum::<f64>() / times.len() as f64;
+    times.sort_by(|a, b| a.total_cmp(b));
+    println!(
+        "{{\"hardware_access\":false,\"samples\":{},\"motors\":7,\"mock_reply_delay_us\":{},\"mean_ms\":{:.6},\"median_ms\":{:.6},\"p95_ms\":{:.6},\"max_ms\":{:.6}}}",
+        samples, delay_us, average, times[times.len() / 2],
+        times[(times.len() - 1) * 95 / 100], times[times.len() - 1]
+    );
+}
